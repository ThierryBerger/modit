# Cargo build output. Matches the root workspace's target/ and each firmware
# workspace's crates/module-*/target/.
target/

# rustfmt backups
**/*.rs.bk

# Debugger artifacts
*.pdb

# Schematic PNGs: generated by `just schematics` for previewing.
# The SVGs are committed instead -- they are text, they diff, and GitHub renders them.
docs/hardware/*.png
plans/figures/*.png
