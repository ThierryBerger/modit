# Per-board firmware configuration.
#
# MODIT_ID is baked into the firmware at compile time and becomes part of the
# BLE name the board advertises (modit-<role>-<id>, e.g. modit-button-a). Every
# board runs identical firmware, so this is the only thing that tells them apart
# -- without it the brain cannot know which physical box it is talking to.
#
# You do not normally need this file: `just flash a` sets MODIT_ID for you.
# It exists to document the variable.

MODIT_ID=a
